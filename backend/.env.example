# Environment Configuration for Ripple Backend Platform (Track C)

# Server Environment
NODE_ENV=development
PORT=4000

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ripple
DB_MAX_CONNECTIONS=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000

# Redis Configuration
REDIS_URL=redis://localhost:6379

# JWT & Application Security
JWT_SECRET=development_super_secret_jwt_key_32_bytes_long_ripple
JWT_EXPIRES_IN=7d
# 32-byte hexadecimal key (64 hex characters) for AES-256-GCM token encryption at rest
TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# GitHub OAuth App Credentials
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:4000/auth/github/callback
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret

# Gemini API Key (Track B real pipeline — leave blank to use mock client)
GEMINI_API_KEY=your_gemini_api_key_here

# Track A & Track B Service Boundaries (Future Integrations)
TRACK_A_URL=http://localhost:5001
TRACK_B_URL=http://localhost:5002

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=20
QA_RATE_LIMIT_MAX=30

# Temporary Workspace Directory for Repositories
WORKSPACE_DIR=./tmp_workspaces
